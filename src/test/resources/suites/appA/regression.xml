<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Testing Framework - Regression Suite" parallel="methods" thread-count="5" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.retry.RetryListener"/>
    </listeners>

    <test name="Regression Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <include name="negative"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.apps.appA.tests.GetUsersTests"/>
            <class name="com.framework.apps.appA.tests.CreateUserTests"/>
            <class name="com.framework.apps.appA.tests.UpdateUserTests"/>
            <class name="com.framework.apps.appA.tests.DeleteUserTests"/>
            <class name="com.framework.apps.appA.tests.AuthTests"/>
            <class name="com.framework.apps.appA.tests.ServiceClientTests"/>
            <class name="com.framework.apps.appA.tests.AppAServiceConfigTests"/>
            <class name="com.framework.config.ConfigManagerTests"/>
            <class name="com.framework.reporting.AllureEnvironmentWriterTests"/>
        </classes>
    </test>

</suite>

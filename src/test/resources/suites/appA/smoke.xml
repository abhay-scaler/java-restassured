<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Testing Framework - Smoke Suite" parallel="methods" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.retry.RetryListener"/>
    </listeners>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.framework.apps.appA.tests.GetUsersTests"/>
            <class name="com.framework.apps.appA.tests.CreateUserTests"/>
            <class name="com.framework.apps.appA.tests.UpdateUserTests"/>
            <class name="com.framework.apps.appA.tests.DeleteUserTests"/>
            <class name="com.framework.apps.appA.tests.AuthTests"/>
        </classes>
    </test>

</suite>

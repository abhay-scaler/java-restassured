<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Testing Framework - Master Suite" parallel="methods" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.retry.RetryListener"/>
    </listeners>

    <test name="All API Tests">
        <classes>
            <class name="com.framework.tests.GetUsersTests"/>
            <class name="com.framework.tests.CreateUserTests"/>
            <class name="com.framework.tests.UpdateUserTests"/>
            <class name="com.framework.tests.DeleteUserTests"/>
            <class name="com.framework.tests.AuthTests"/>
            <class name="com.framework.tests.ServiceClientTests"/>
        </classes>
    </test>

</suite>
